{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "chrome"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "src",
    "bench",
    "e2e",
    "tests",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
