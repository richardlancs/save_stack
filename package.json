{
  "name": "scroganize",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Search your saved social-media collections (TikTok first) from a Chrome side panel.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "echo 'The M0 spike was retired in M1. Reproduce it with: git checkout m0-spike' && exit 1",
    "fixtures:tiktok": "node scripts/make-tiktok-fixtures.mjs",
    "bench:ingest": "tsx bench/ingest.ts",
    "build:e2e": "cross-env WXT_E2E_HOOKS=1 wxt build",
    "e2e:storage": "npm run build:e2e && tsx bench/run-ingest.ts",
    "bench:search": "tsx bench/search.ts",
    "check:build": "node scripts/check-build.mjs",
    "gate": "npm run typecheck && npm test && npm run bench:ingest && npm run bench:search && npm run build && npm run check:build && npm run e2e:storage",
    "mutate": "node scripts/mutation-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "cross-env": "^10.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1"
  }
}
